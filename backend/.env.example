# Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/sketch_db
DB_NAME=sketch_db

# Hugging Face API (Required for AI sketch generation)
# Get your token at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# File Upload
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# Model Paths
MODEL_PATH=./models/saved
CNN_MODEL=vggface_model.h5
SVM_MODEL=svm_classifier.pkl
GAN_MODEL=pix2pix_generator.pth

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Configuration
FEATURE_VECTOR_SIZE=2048
SVM_KERNEL=rbf
SVM_C=1.0
CONFIDENCE_THRESHOLD=0.6

# Image Processing
IMAGE_SIZE=256
SKETCH_SIZE=512
FACE_CASCADE_PATH=./models/haarcascade_frontalface_default.xml

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
