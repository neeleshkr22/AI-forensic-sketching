        photo_url: 'https://i.pravatar.cc/400?img=27',
        confidence_score: 0.65,
        similarity: 0.65,
        rank: 6
      }
    ]
    
    // EXTRACT FEATURES FROM SKETCH
    const sketchFeatures = extractFeatures()
    console.log('🎯 Sketch Features:', sketchFeatures)
    
    // SMART GENDER FILTERING
    let filteredResults = allMockResults
    if (sketchFeatures.gender === 'Male') {
      filteredResults = allMockResults.filter(record => record.gender === 'Male')
      console.log(`🚹 Detected MALE sketch - Showing ${filteredResults.length} male records only`)
    } else if (sketchFeatures.gender === 'Female') {
      filteredResults = allMockResults.filter(record => record.gender === 'Female')
      console.log(`🚺 Detected FEMALE sketch - Showing ${filteredResults.length} female records only`)
    } else {
      console.log('⚧️ Gender unclear - Showing all records')
    }
    
    // FEATURE MATCHING ALGORITHM - Score each record based on similarity
    const scoredResults = filteredResults.map(record => {
      let matchScore = 0
      let maxScore = 0
      
      // Age matching (weight: 15 points)
      maxScore += 15
      if (sketchFeatures.ageRange !== 'any' && record.features.ageRange === sketchFeatures.ageRange) {
        matchScore += 15
      } else if (sketchFeatures.ageRange === 'any') {
        matchScore += 10
      }
      
      // Bald feature (weight: 30 points - very distinctive)
      if (sketchFeatures.hasBald) {
        maxScore += 30
        if (record.features.hasBald) {
          matchScore += 30 // Perfect match for bald
        }
      } else {
        maxScore += 20
        if (!record.features.hasBald) {
          matchScore += 20 // Has hair
        }
      }
      
      // Hair color (weight: 15 points)
      if (!sketchFeatures.hasBald) {
        maxScore += 15
        if (sketchFeatures.hairColor !== 'any' && record.features.hairColor === sketchFeatures.hairColor) {
          matchScore += 15
        } else if (sketchFeatures.hairColor === 'any') {
          matchScore += 10
        }
      }
      
      // Beard matching (weight: 20 points)
      if (sketchFeatures.hasBeard) {
        maxScore += 20
        if (record.features.hasBeard || record.features.hasGoatee) {
          matchScore += 20
        }
      } else {
        maxScore += 10
        if (!record.features.hasBeard) {
          matchScore += 10
        }
      }
      
      // Glasses matching (weight: 20 points)
      if (sketchFeatures.hasGlasses) {
        maxScore += 20
        if (record.features.hasGlasses) {
          matchScore += 20
        }
      } else {
        maxScore += 10
        if (!record.features.hasGlasses) {
          matchScore += 10
        }
      }
      
      // Calculate confidence score (0.60 to 0.98)
      const confidenceScore = Math.min(0.98, Math.max(0.60, (matchScore / maxScore) * 0.98))
      
      console.log(`${record.name}: ${matchScore}/${maxScore} = ${(confidenceScore * 100).toFixed(1)}%`)
      
      return {
        ...record,
        confidence_score: confidenceScore,
        matchScore,
        maxScore
      }
    })
    
    // Sort by confidence score (highest first)
    filteredResults = scoredResults.sort((a, b) => b.confidence_score - a.confidence_score)
    
    // INTELLIGENT THRESHOLD LOGIC
    // Apply threshold filtering first
    let thresholdFiltered = filteredResults.filter(r => r.confidence_score >= threshold)
    
    // SMART RESULT LIMITING based on threshold
    let finalResults = thresholdFiltered
    if (threshold >= 0.90) {
      // High threshold (90%+) = Show only TOP 1 result
      finalResults = thresholdFiltered.slice(0, 1)
      console.log(`🎯 High threshold (${(threshold * 100).toFixed(0)}%) - Showing TOP 1 result`)
    } else if (threshold >= 0.80) {
      // Medium-high threshold (80-89%) = Show top 2-3 results
      finalResults = thresholdFiltered.slice(0, 3)
      console.log(`🎯 Medium threshold (${(threshold * 100).toFixed(0)}%) - Showing TOP 3 results`)
    } else if (threshold >= 0.70) {
      // Medium threshold (70-79%) = Show top 4-5 results
      finalResults = thresholdFiltered.slice(0, 5)
      console.log(`🎯 Medium-low threshold (${(threshold * 100).toFixed(0)}%) - Showing TOP 5 results`)
    } else {
      // Low threshold (<70%) = Show all matching results
      console.log(`🎯 Low threshold (${(threshold * 100).toFixed(0)}%) - Showing ALL ${thresholdFiltered.length} results`)
    }
    
    // Re-rank results after filtering
    finalResults = finalResults.map((result, index) => ({
      ...result,
      rank: index + 1
    }))
    
    console.log(`✅ Final Results: ${finalResults.length} records (Gender: ${detectedGender}, Threshold: ${(threshold * 100).toFixed(0)}%)`)
    
    // ALWAYS USE FILTERED MOCK DATA (for demo purposes)
